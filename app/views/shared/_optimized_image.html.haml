- cloudinary_configured = Rails.application.credentials.dig(:cloudinary, :cloud_name).present?
- if cloudinary_configured
  - thumbnail_url = cl_image_path(attachment.blob.key, width: 480, crop: :limit, quality: :auto, fetch_format: :auto)
  - display_url = cl_image_path(attachment.blob.key, width: 1800, crop: :limit, quality: :auto, fetch_format: :auto)
  - original_url = cl_image_path(attachment.blob.key)
- else
  - thumbnail_url = url_for(attachment)
  - display_url = thumbnail_url
  - original_url = thumbnail_url

.answer-image-card
  %button.answer-image-button{ type: "button", aria: { label: "#{title}を拡大表示" }, data: { action: "image-viewer#open", image_url: display_url, original_url: original_url, image_alt: title } }
    = image_tag thumbnail_url, loading: "lazy", decoding: "async", alt: title, class: "answer-image-thumbnail"
    .answer-image-label
      %span= title
      %span.answer-image-zoom 拡大する
